# Copy this file to .env only if you want bootstrap overrides.
# .env is gitignored — it will never be committed.

# Optional advanced overrides. Leave blank for plug-and-play installs; the app
# will generate persistent random signing secrets in the Docker data volume.
SECRET_KEY=
JWT_SECRET_KEY=

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Cleaner account
CLEANER_USERNAME=cleaner
CLEANER_PASSWORD=cleaner12345

# ngrok remote access
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=

# Calendar guest default password
CALENDAR_GUEST_DEFAULT_PASSWORD=guest12345

# Optional timezone override (IANA name). Leave blank for auto-detection.
APP_TIMEZONE=

# Log retention
AUDIT_LOG_RETENTION_DAYS=180
DOOR_LOG_RETENTION_DAYS=90
